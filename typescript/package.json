{
  "name": "@cellaflow/sdk",
  "version": "0.10.0",
  "description": "TypeScript/Node.js SDK for Cellaflow: at-most-once tool calls and durable replay for AI agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.14.1"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "tsc && node --test tests/*.test.mjs",
    "test:integration": "tsc && node --test tests/integration/*.test.mjs"
  },
  "keywords": [
    "cellaflow",
    "ai-agents",
    "agents",
    "llm",
    "idempotency",
    "exactly-once",
    "durable-execution",
    "workflow",
    "grpc",
    "connect-rpc",
    "sdk"
  ],
  "author": "Cellaflow <hello@cellaflow.com>",
  "license": "Apache-2.0 OR MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cellaflow/cellaflow-sdks.git",
    "directory": "typescript"
  },
  "homepage": "https://cellaflow.com",
  "bugs": {
    "url": "https://github.com/cellaflow/cellaflow-sdks/issues"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@connectrpc/connect": "~2.0.4",
    "@connectrpc/connect-node": "~2.0.4",
    "@msgpack/msgpack": "^3.1.3",
    "canonicalize": "^4.0.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protoc-gen-es": "^2.17.0",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
